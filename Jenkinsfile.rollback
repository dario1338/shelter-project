def render

pipeline {
    // No pipeline-wide agent: only the parts that do work allocate one,
    // so the manual approval does not hold an executor while it waits.
    agent none

    parameters {
        string(name: 'TARGET_BUILD', defaultValue: '',
               description: 'OPTIONAL: number of an earlier successful delivery build of the API (job shelter-cd) to roll back to. Leave empty to switch back to the version the idle instance currently holds (fast path).')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        // A failed release or rollback restores what ran before; the record of the last successful rollback may say which digest that was.
        copyArtifactPermission('shelter-cd*,shelter-rollback*')
    }

    stages {
        stage('Prepare') {
            agent { label 'docker' }
            stages {
                stage('Load helpers') {
                    steps {
                        checkout scm
                        script {
                            render = load 'jenkins/render.groovy'
                            render.init()
                        }
                    }
                }

                stage('Inspect production') {
                    steps {
                        script {
                            def buildNumber = (params.TARGET_BUILD ?: '').trim()
                            if (buildNumber && !(buildNumber ==~ /^[0-9]+$/)) {
                                error "TARGET_BUILD must be the number of an earlier delivery build (digits only), got: '${buildNumber}'"
                            }
                            env.TARGET_BUILD_CLEAN = buildNumber
                            env.TARGET_COMMIT = ''
                            env.TARGET_DIGEST = ''
                            if (buildNumber) {
                                // The record of that build: which commit and which image digest it released to production.
                                def target = render.releaseFromBuild(buildNumber)
                                env.TARGET_COMMIT = target.commit
                                env.TARGET_DIGEST = target.digest
                                // Roll back only to an image our CI signed (releases from before signing was introduced cannot be targeted)
                                render.verifySignature("${env.IMAGE_REPO}@${env.TARGET_DIGEST}")
                                currentBuild.displayName = "#${env.BUILD_NUMBER} to ${target.commit.take(7)}"
                            }

                            render.resolveInstances()

                            // Free-tier instances sleep, and requests that only pass through the proxy did not wake them
                            // (observed). Requests made directly to an instance do. A rollback must also work when
                            // production is broken, so an unhealthy active instance is reported, not fatal.
                            def activeUp = render.probeHealthy("https://${env.ACTIVE_HOST}", 5)
                            if (activeUp) {
                                env.ACTIVE_REVISION = render.fetchRevision("https://${env.ACTIVE_HOST}") ?: 'unknown'
                            } else {
                                env.ACTIVE_REVISION = 'unreachable'
                                echo "WARNING: the active instance ${env.ACTIVE_HOST} is not answering. Treating this as an emergency rollback."
                            }
                            echo "Production (${env.ACTIVE_HOST}) revision: ${env.ACTIVE_REVISION}"

                            if (buildNumber) {
                                if (env.ACTIVE_REVISION == env.TARGET_COMMIT) {
                                    error "Production already runs ${env.TARGET_COMMIT.take(7)}, nothing to roll back"
                                }
                                env.TARGET_DESCRIPTION = "${env.TARGET_COMMIT.take(7)} (delivery build #${buildNumber}, ${env.TARGET_DIGEST}), which will first be deployed to the idle instance ${env.IDLE_HOST}"
                            } else {
                                // Also wakes up the idle instance, so that the switch itself is fast.
                                render.waitHealthy("https://${env.IDLE_HOST}")
                                def idleRevision = render.fetchRevision("https://${env.IDLE_HOST}")
                                if (idleRevision && idleRevision == env.ACTIVE_REVISION) {
                                    error "The idle instance runs the same revision as production (${idleRevision}), nothing to roll back to. Use TARGET_BUILD to pick an earlier release."
                                }
                                env.TARGET_DESCRIPTION = "the version held by the idle instance ${env.IDLE_HOST} (revision ${idleRevision ?: 'unknown'})"
                            }
                            echo "Rollback target: ${env.TARGET_DESCRIPTION}"
                        }
                    }
                }
            }
        }

        // No agent here on purpose: waiting for a human must not occupy an executor.
        stage('Approval') {
            steps {
                script {
                    def shown = env.ACTIVE_REVISION.length() == 40 ? env.ACTIVE_REVISION.take(7) : env.ACTIVE_REVISION
                    timeout(time: 30, unit: 'MINUTES') {
                        input message: "Roll back production from ${shown} (${env.ACTIVE_HOST}) to ${env.TARGET_DESCRIPTION}?",
                              ok: 'Roll back'
                    }
                }
            }
        }

        stage('Execute rollback') {
            agent { label 'docker' }
            options {
                lock('shelter-production')
            }
            steps {
                // The agent workspace is fresh after the approval wait.
                checkout scm
                withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                    script {
                        // Traffic may have been switched while the approval was pending.
                        def activeAtApproval = env.ACTIVE_HOST
                        render.resolveInstances()
                        if (env.ACTIVE_HOST != activeAtApproval) {
                            error "Production traffic moved from ${activeAtApproval} to ${env.ACTIVE_HOST} while waiting for approval. Aborting, please inspect and run again."
                        }

                        if (env.TARGET_DIGEST) {
                            def deployId = render.deployImage(env.IDLE_ID, "${env.IMAGE_REPO}@${env.TARGET_DIGEST}")
                            render.waitForDeploy(env.IDLE_ID, deployId)
                        }

                        // Verify the target BEFORE it receives traffic (directly, which also wakes it up).
                        render.waitHealthy("https://${env.IDLE_HOST}")
                        def revision = render.fetchRevision("https://${env.IDLE_HOST}")
                        if (env.TARGET_COMMIT && revision && revision != env.TARGET_COMMIT) {
                            error "Idle instance reports revision ${revision}, expected ${env.TARGET_COMMIT}"
                        }
                        if (!revision) {
                            echo 'WARNING: the target version does not report a revision (no /api/info). Only health and routing will be verified.'
                        }

                        try {
                            render.setUpstream(env.IDLE_HOST)
                            render.verifyServedBy(env.IDLE_HOST)
                            if (revision) {
                                render.verifyThroughProxy(env.IDLE_HOST, revision)
                                dir('shelter-api') {
                                    sh "./mvnw test -Dtest=StagingSmokeTest -DexcludedGroups=never -Dstaging.url=${env.PROXY_URL} -Dstaging.expectedRevision=${revision}"
                                }
                            }
                        } catch (e) {
                            echo "Verification after the rollback failed (${e.getMessage()}). Restoring ${env.ACTIVE_HOST}"
                            render.setUpstream(env.ACTIVE_HOST)
                            render.verifyServedBy(env.ACTIVE_HOST)
                            error "Rollback failed and traffic was restored to ${env.ACTIVE_HOST}: ${e.getMessage()}"
                        }
                        echo "Production now runs ${revision ?: 'an older version'} on ${env.IDLE_HOST}"

                        // Reached only when the rollback succeeded (the catch block above always ends with error).
                        // Without TARGET_BUILD the idle instance already held the version, so its digest comes from the records.
                        def rolledBackDigest = env.TARGET_DIGEST ?: (revision ? render.digestOf(render.imageForRevision(revision)) : '')
                        render.recordRelease(env.TARGET_COMMIT ?: revision, rolledBackDigest, 'rollback')
                    }
                }
            }
        }
    }
}