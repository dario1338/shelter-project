def render

pipeline {
    agent any

    parameters {
        string(name: 'GIT_COMMIT_FULL', defaultValue: '',
               description: 'Full commit hash (40 characters) of the image to deliver')
        booleanParam(name: 'TEST_ROLLBACK', defaultValue: false,
               description: 'TEST ONLY: fail the verification right after the traffic switch, to demonstrate the automatic rollback')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
    }

    stages {
        stage('Load helpers') {
            steps {
                checkout scm
                script {
                    render = load 'jenkins/render.groovy'
                    render.init()
                }
            }
        }

        stage('Validate parameters') {
            steps {
                script {
                    def commit = params.GIT_COMMIT_FULL.trim()
                    if (!(commit ==~ /^[0-9a-f]{40}$/)) {
                        error "GIT_COMMIT_FULL must be a full 40-character hash, got: '${commit}'"
                    }
                    env.COMMIT_FULL = commit
                    env.IMAGE_URL = "${env.IMAGE_REPO}:${commit.take(7)}"
                    echo "Delivering image ${env.IMAGE_URL}"
                }
            }
        }

        stage('Staging: deploy') {
            steps {
                withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                    script {
                        def deployId = render.deployImage(env.STAGING_ID, env.IMAGE_URL)
                        render.waitForDeploy(env.STAGING_ID, deployId)
                    }
                }
            }
        }

        stage('Staging: verify revision') {
            steps {
                script {
                    render.verifyRevision(env.STAGING_URL, env.COMMIT_FULL)
                }
            }
        }

        stage('Staging: smoke tests') {
            steps {
                dir('shelter-api') {
                    sh "./mvnw test -Dtest=StagingSmokeTest -DexcludedGroups=never -Dstaging.url=${env.STAGING_URL} -Dstaging.expectedRevision=${env.COMMIT_FULL}"
                }
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Release ${env.IMAGE_URL} to production?", ok: 'Release'
                }
            }
        }

        // Only one job at a time may change production traffic (release or rollback).
        // The lock is taken after the approval so that a waiting release never blocks a rollback.
        stage('Production release') {
            options {
                lock('shelter-production')
            }
            stages {
                stage('Production: find idle instance') {
                    steps {
                        script {
                            render.resolveInstances()
                        }
                    }
                }

                stage('Production: deploy to idle instance') {
                    steps {
                        withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                            script {
                                def deployId = render.deployImage(env.IDLE_ID, env.IMAGE_URL)
                                render.waitForDeploy(env.IDLE_ID, deployId)
                                render.verifyRevision("https://${env.IDLE_HOST}", env.COMMIT_FULL)
                            }
                        }
                    }
                }

                stage('Production: smoke tests on idle instance') {
                    steps {
                        dir('shelter-api') {
                            sh "./mvnw test -Dtest=StagingSmokeTest -DexcludedGroups=never -Dstaging.url=https://${env.IDLE_HOST} -Dstaging.expectedRevision=${env.COMMIT_FULL}"
                        }
                    }
                }

                stage('Production: switch traffic and verify') {
                    steps {
                        withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                            script {
                                try {
                                    render.setUpstream(env.IDLE_HOST)
                                    render.verifyThroughProxy(env.IDLE_HOST, env.COMMIT_FULL)
                                    if (params.TEST_ROLLBACK) {
                                        error 'TEST_ROLLBACK is set: simulated failure after the traffic switch'
                                    }
                                    dir('shelter-api') {
                                        sh "./mvnw test -Dtest=StagingSmokeTest -DexcludedGroups=never -Dstaging.url=${env.PROXY_URL} -Dstaging.expectedRevision=${env.COMMIT_FULL}"
                                    }
                                } catch (e) {
                                    echo "Verification after the switch failed (${e.getMessage()}). Rolling back to ${env.ACTIVE_HOST}"
                                    render.setUpstream(env.ACTIVE_HOST)
                                    render.verifyServedBy(env.ACTIVE_HOST)
                                    error "Release rolled back to ${env.ACTIVE_HOST}: ${e.getMessage()}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}