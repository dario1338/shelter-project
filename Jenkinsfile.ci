pipeline {
    agent { label 'docker'}

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Build') {
            steps {
                dir('shelter-api') {
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Backend: Unit Tests') {
            steps {
                dir('shelter-api') {
                    sh './mvnw test'
                }
            }
        }

        stage('Backend: SonarQube Analysis') {
            steps {
                dir('shelter-api') {
                    withSonarQubeEnv('sonar-server') {
                        sh './mvnw sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Backend: Integration Tests') {
            steps {
                dir('shelter-api') {
                    withEnv(['TESTCONTAINERS_RYUK_DISABLED=true']) {
                        sh './mvnw test -Dtest=*IntegrationTest'
                    }
                }
            }
        }

        stage('Backend: Acceptance Tests') {
            steps {
                dir('shelter-api') {
                    withEnv(['TESTCONTAINERS_RYUK_DISABLED=true']) {
                        sh './mvnw test -Dtest=*AcceptanceTest'
                    }
                }
            }
        }

        stage('Docker: Build (verification)') {
            when { not { branch 'main' } }
            steps {
                dir('shelter-api') {
                    script {
                        def checkTag = "shelter-api:check-${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${checkTag} || true"
                        sh "docker build --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${checkTag} ."
                        sh "docker rmi -f ${checkTag} || true"
                    }
                }
            }
        }

        stage('Docker: Build & Push') {
            when { branch 'main' }
            steps {
                dir('shelter-api') {
                    script {
                        def imageTag = "dario1338/shelter-api:${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${imageTag} || true"
                        sh "docker buildx build --platform linux/amd64 --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${imageTag} --load ."

                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            try {
                                sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                                sh "docker push ${imageTag}"
                            } finally {
                                sh 'docker logout || true'
                            }
                        }
                    }
                }
            }
        }

        stage('Proxy: Build & verify config') {
            when { not { branch 'main' } }
            steps {
                dir('shelter-proxy') {
                    script {
                        def checkTag = "shelter-proxy:check-${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${checkTag} || true"
                        try {
                            sh "docker build -t ${checkTag} ."
                            sh "docker run --rm -e API_UPSTREAM=example.com -e UI_UPSTREAM=example.com ${checkTag} nginx -t"
                        } finally {
                            sh "docker rmi -f ${checkTag} || true"
                        }
                    }
                }
            }
        }

        stage('Proxy: Build & Push') {
            when { branch 'main' }
            steps {
                dir('shelter-proxy') {
                    script {
                        def imageTag = "dario1338/shelter-proxy:${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${imageTag} || true"
                        sh "docker buildx build --platform linux/amd64 -t ${imageTag} --load ."

                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            try {
                                sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                                sh "docker push ${imageTag}"
                            } finally {
                                sh 'docker logout || true'
                            }
                        }
                    }
                }
            }
        }

        // Continuous Delivery: hand the freshly published image over to the delivery pipeline.
        // wait: false, so this build does not hold an executor while shelter-cd waits for the approval.
        stage('Trigger delivery') {
            when { branch 'main' }
            steps {
                build job: '/shelter-cd',
                      parameters: [string(name: 'GIT_COMMIT_FULL', value: env.GIT_COMMIT)],
                      wait: false
            }
        }
    }
}