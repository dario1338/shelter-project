// Scan a local image with Trivy: report HIGH/CRITICAL findings, fail the build only on CRITICAL
// findings that already have a fix available (--ignore-unfixed).
def trivyScan(String image) {
    sh "trivy image --no-progress --timeout 15m --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed ${image}"
    sh "trivy image --no-progress --timeout 15m --scanners vuln --severity CRITICAL --ignore-unfixed --exit-code 1 ${image}"
}

// Pushes an image and returns its registry digest (sha256:...). The digest is the identity of the
// exact content that was scanned and pushed; delivery uses it instead of the movable tag.
def pushImage(String image, String name) {
    def log = "push-${name}.log"
    sh "docker push ${image} > ${log} 2>&1 || { cat ${log}; exit 1; }; cat ${log}"
    def digest = sh(script: "grep -Eo 'digest: sha256:[0-9a-f]{64}' ${log} | tail -1 | cut -d' ' -f2", returnStdout: true).trim()
    sh "rm -f ${log}"
    if (!(digest ==~ /^sha256:[0-9a-f]{64}$/)) {
        error "Could not read the digest of ${image} from the push output"
    }
    echo "Pushed ${image} with digest ${digest}"
    return digest
}

// Software Bill of Materials: the inventory of a finished image (operating system packages and
// libraries) as CycloneDX JSON, kept with the build under "Build Artifacts". The file is written to the
// workspace root, outside the component directories, so it never ends up in a Docker build context.
// Trivy does not scan for vulnerabilities in this mode; the scans above do that.
def writeSbom(String image, String name) {
    def file = "sbom/${name}.cdx.json"
    dir(env.WORKSPACE) {
        sh "mkdir -p sbom && trivy image --no-progress --timeout 15m --format cyclonedx --output ${file} ${image}"
        sh "grep -Eq '\"bomFormat\" *: *\"CycloneDX\"' ${file}"
        archiveArtifacts artifacts: file, fingerprint: true
    }
}

// Decide which components a build has to cover.
//  - Pull request: files changed compared to the target branch. A change of the pipeline itself
//    (this file, jenkins/) selects every component, so the change is verified on all of them.
//  - Branch build (main): files changed since the last successful build of this branch, so a failed
//    build never hides changes. Pipeline files are ignored: they were verified in the pull request.
// Anything that cannot be determined (no previous build, git failure) selects every component, so a
// check is never skipped by mistake. Branch names and hashes are read from the environment inside
// the shell script, never interpolated into it.
def detectChangedComponents() {
    def everything = [api: true, ui: true, proxy: true]
    def pullRequest = env.CHANGE_TARGET != null
    def diff
    if (pullRequest) {
        sh 'git fetch --no-tags origin "+refs/heads/${CHANGE_TARGET}:refs/remotes/origin/${CHANGE_TARGET}" || true'
        diff = 'git diff --name-only "origin/${CHANGE_TARGET}...HEAD" > .changed-files'
    } else if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
        echo "Comparing with the last successful build: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
        diff = 'git diff --name-only "${GIT_PREVIOUS_SUCCESSFUL_COMMIT}" HEAD > .changed-files'
    } else {
        echo 'There is no previous successful build to compare with, building every component.'
        return everything
    }
    def status = sh(returnStatus: true, script: diff)
    if (status != 0) {
        echo 'Could not determine the changed files, building every component.'
        return everything
    }
    def changed = [api: false, ui: false, proxy: false]
    for (String file : readFile('.changed-files').readLines()) {
        if (pullRequest && (file == 'Jenkinsfile.ci' || file.startsWith('jenkins/'))) {
            return everything
        } else if (file.startsWith('shelter-api/')) {
            changed.api = true
        } else if (file.startsWith('shelter-ui/')) {
            changed.ui = true
        } else if (file.startsWith('shelter-proxy/')) {
            changed.proxy = true
        }
    }
    return changed
}

pipeline {
    agent { label 'docker' }

    options {
        // Keep the history of every branch and pull request bounded; the SBOMs are small but there are three per build.
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect changes') {
            steps {
                script {
                    def components = detectChangedComponents()
                    env.RUN_API = "${components.api}"
                    env.RUN_UI = "${components.ui}"
                    env.RUN_PROXY = "${components.proxy}"
                    echo "Components to build -> api: ${components.api}, ui: ${components.ui}, proxy: ${components.proxy}"
                }
            }
        }

        // ---------------------------------------------------------------- Backend

        stage('Backend: Build') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Backend: Unit Tests') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    sh './mvnw test'
                }
            }
        }

        stage('Backend: Integration Tests') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    sh './mvnw verify -DskipUTs=true -Dit.test=*IntegrationTest'
                }
            }
        }

        stage('Backend: Acceptance Tests') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    sh './mvnw verify -DskipUTs=true -Dit.test=*AcceptanceTest'
                }
            }
        }

        stage('Backend: Coverage Gate') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    sh './mvnw jacoco:check@coverage-check'
                }
            }
        }

        stage('Backend: SonarQube Analysis') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                dir('shelter-api') {
                    withSonarQubeEnv('sonar-server') {
                        sh './mvnw sonar:sonar'
                    }
                }
            }
        }

        // waitForQualityGate follows the most recent analysis of this build, so every analysis
        // is followed by its own gate before the next analysis starts.
        stage('Backend: Quality Gate') {
            when { expression { env.RUN_API == 'true' } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker: Build (verification)') {
            when {
                allOf {
                    not { branch 'main' }
                    expression { env.RUN_API == 'true' }
                }
            }
            steps {
                dir('shelter-api') {
                    script {
                        def checkTag = "shelter-api:check-${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${checkTag} || true"
                        try {
                            sh "docker build --pull --no-cache-filter runtime --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${checkTag} ."
                            trivyScan(checkTag)
                            writeSbom(checkTag, "shelter-api-${env.GIT_COMMIT.take(7)}")
                        } finally {
                            sh "docker rmi -f ${checkTag} || true"
                        }
                    }
                }
            }
        }

        stage('Docker: Build & Push') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_API == 'true' }
                }
            }
            steps {
                dir('shelter-api') {
                    script {
                        def imageTag = "dario1338/shelter-api:${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${imageTag} || true"
                        try {
                            sh "docker buildx build --pull --no-cache-filter runtime --platform linux/amd64 --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${imageTag} --load ."
                            trivyScan(imageTag)
                            writeSbom(imageTag, "shelter-api-${env.GIT_COMMIT.take(7)}")

                            withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                try {
                                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                                    env.API_IMAGE_DIGEST = pushImage(imageTag, "api")
                                } finally {
                                    sh 'docker logout || true'
                                }
                            }
                        } finally {
                            // The image lives on Docker Hub; do not keep a local copy on the agent
                            sh "docker rmi -f ${imageTag} || true"
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------- Frontend

        stage('UI: Install') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    sh 'npm ci'
                }
            }
        }

        stage('UI: Lint') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    sh 'npm run lint'
                }
            }
        }

        stage('UI: Unit Tests & Coverage') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    sh 'npm run test:coverage'
                }
            }
        }

        // Trivy scans the finished image, but the npm packages are bundled into static files there,
        // so dependency vulnerabilities are checked here. Same policy as Trivy: report HIGH and
        // above, fail only on CRITICAL, and only for packages that ship to production.
        stage('UI: Dependency Audit') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    sh 'npm audit --audit-level=high || true'
                    sh 'npm audit --omit=dev --audit-level=critical'
                }
            }
        }

        stage('UI: Build') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    sh 'npm run build'
                }
            }
        }

        stage('UI: SonarQube Analysis') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                dir('shelter-ui') {
                    withSonarQubeEnv('sonar-server') {
                        sh 'SONAR_TOKEN="$SONAR_AUTH_TOKEN" npx @sonar/scan'
                    }
                }
            }
        }

        stage('UI: Quality Gate') {
            when { expression { env.RUN_UI == 'true' } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('UI: Docker Build (verification)') {
            when {
                allOf {
                    not { branch 'main' }
                    expression { env.RUN_UI == 'true' }
                }
            }
            steps {
                dir('shelter-ui') {
                    script {
                        def checkTag = "shelter-ui:check-${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${checkTag} || true"
                        try {
                            sh "docker build --pull --no-cache-filter runtime --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${checkTag} ."
                            trivyScan(checkTag)
                            writeSbom(checkTag, "shelter-ui-${env.GIT_COMMIT.take(7)}")
                        } finally {
                            sh "docker rmi -f ${checkTag} || true"
                        }
                    }
                }
            }
        }

        stage('UI: Docker Build & Push') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_UI == 'true' }
                }
            }
            steps {
                dir('shelter-ui') {
                    script {
                        def imageTag = "dario1338/shelter-ui:${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${imageTag} || true"
                        try {
                            sh "docker buildx build --pull --no-cache-filter runtime --platform linux/amd64 --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${imageTag} --load ."
                            trivyScan(imageTag)
                            writeSbom(imageTag, "shelter-ui-${env.GIT_COMMIT.take(7)}")

                            withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                try {
                                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                                    env.UI_IMAGE_DIGEST = pushImage(imageTag, "ui")
                                } finally {
                                    sh 'docker logout || true'
                                }
                            }
                        } finally {
                            sh "docker rmi -f ${imageTag} || true"
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------ Proxy

        stage('Proxy: Build & verify config') {
            when {
                allOf {
                    not { branch 'main' }
                    expression { env.RUN_PROXY == 'true' }
                }
            }
            steps {
                dir('shelter-proxy') {
                    script {
                        def checkTag = "shelter-proxy:check-${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${checkTag} || true"
                        try {
                            sh "docker build --pull --no-cache --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${checkTag} ."
                            trivyScan(checkTag)
                            writeSbom(checkTag, "shelter-proxy-${env.GIT_COMMIT.take(7)}")
                            sh "docker run --rm -e API_UPSTREAM=example.com -e UI_UPSTREAM=example.com ${checkTag} nginx -t"
                            sh "sh ./verify.sh ${checkTag} ${env.GIT_COMMIT}"
                        } finally {
                            sh "docker rmi -f ${checkTag} || true"
                        }
                    }
                }
            }
        }

        stage('Proxy: Build & Push') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_PROXY == 'true' }
                }
            }
            steps {
                dir('shelter-proxy') {
                    script {
                        def imageTag = "dario1338/shelter-proxy:${env.GIT_COMMIT.take(7)}"
                        sh "docker rmi -f ${imageTag} || true"
                        try {
                            sh "docker buildx build --pull --no-cache --platform linux/amd64 --build-arg GIT_COMMIT=${env.GIT_COMMIT} -t ${imageTag} --load ."
                            trivyScan(imageTag)
                            writeSbom(imageTag, "shelter-proxy-${env.GIT_COMMIT.take(7)}")

                            withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                try {
                                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                                    env.PROXY_IMAGE_DIGEST = pushImage(imageTag, "proxy")
                                } finally {
                                    sh 'docker logout || true'
                                }
                            }
                        } finally {
                            sh "docker rmi -f ${imageTag} || true"
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------- Delivery
        // Continuous Delivery: hand every freshly published image over to the delivery pipeline of its
        // component. wait: false, so this build does not hold an executor while the delivery waits for
        // the approval.
        stage('Trigger API delivery') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_API == 'true' }
                }
            }
            steps {
                build job: '/shelter-cd',
                      parameters: [string(name: 'GIT_COMMIT_FULL', value: env.GIT_COMMIT),
                                   string(name: 'IMAGE_DIGEST', value: env.API_IMAGE_DIGEST)],
                      wait: false
            }
        }

        stage('Trigger UI delivery') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_UI == 'true' }
                }
            }
            steps {
                build job: '/shelter-cd-ui',
                      parameters: [string(name: 'GIT_COMMIT_FULL', value: env.GIT_COMMIT),
                                   string(name: 'IMAGE_DIGEST', value: env.UI_IMAGE_DIGEST)],
                      wait: false
            }
        }

        stage('Trigger proxy delivery') {
            when {
                allOf {
                    branch 'main'
                    expression { env.RUN_PROXY == 'true' }
                }
            }
            steps {
                build job: '/shelter-cd-proxy',
                      parameters: [string(name: 'GIT_COMMIT_FULL', value: env.GIT_COMMIT),
                                   string(name: 'IMAGE_DIGEST', value: env.PROXY_IMAGE_DIGEST)],
                      wait: false
            }
        }
    }

    post {
        always {
            // Remove build cache older than a week so the agent disk does not fill up
            sh 'docker builder prune --filter until=168h -f || true'
        }
    }
}