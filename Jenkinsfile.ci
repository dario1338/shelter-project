pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Build') {
            steps {
                dir('shelter-api') {
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Backend: Unit Tests') {
            steps {
                dir('shelter-api') {
                    sh './mvnw test'
                }
            }
        }

        stage('Backend: Integration Tests') {
            steps {
                dir('shelter-api') {
                    withEnv(['TESTCONTAINERS_RYUK_DISABLED=true']) {
                        sh './mvnw test -Dtest=*IntegrationTest'
                    }
                }
            }
        }
    }
}