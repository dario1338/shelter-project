def render

// Manual rollback of the production UI to an older image of shelter-ui.
// The UI has one production service, so a rollback is a deploy of the older image followed by the same
// verification as a release. If that fails, the version that was running before is deployed again.
pipeline {
    // No pipeline-wide agent: only the parts that do work allocate one,
    // so the manual approval does not hold an executor while it waits.
    agent none

    parameters {
        string(name: 'TARGET_BUILD', defaultValue: '',
               description: 'REQUIRED: number of an earlier successful delivery build of the UI (job shelter-cd-ui) to roll production back to')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        // A failed release or rollback restores what ran before; the record of the last successful rollback may say which digest that was.
        copyArtifactPermission('shelter-cd*,shelter-rollback*')
    }

    stages {
        stage('Prepare') {
            agent { label 'docker' }
            steps {
                checkout scm
                script {
                    render = load 'jenkins/render.groovy'
                    render.init()
                    render.useComponent('ui')

                    def buildNumber = (params.TARGET_BUILD ?: '').trim()
                    if (!(buildNumber ==~ /^[0-9]+$/)) {
                        error "TARGET_BUILD must be the number of an earlier delivery build (digits only), got: '${buildNumber}'"
                    }
                    // The record of that build: which commit and which image digest it released to production.
                    def target = render.releaseFromBuild(buildNumber)
                    env.TARGET_BUILD_CLEAN = buildNumber
                    env.TARGET_COMMIT = target.commit
                    env.TARGET_DIGEST = target.digest
                    currentBuild.displayName = "#${env.BUILD_NUMBER} to ${target.commit.take(7)}"

                    // Also wakes up the service if it sleeps. '' means the running image predates version.json.
                    env.CURRENT_REVISION = render.fetchRevision(env.PROD_URL) ?: 'unknown'
                    echo "Production UI revision: ${env.CURRENT_REVISION}"
                    if (env.CURRENT_REVISION == env.TARGET_COMMIT) {
                        error "Production already runs ${env.TARGET_COMMIT.take(7)}, nothing to roll back"
                    }
                }
            }
        }

        // No agent here on purpose: waiting for a human must not occupy an executor.
        stage('Approval') {
            steps {
                script {
                    def shown = env.CURRENT_REVISION.length() == 40 ? env.CURRENT_REVISION.take(7) : env.CURRENT_REVISION
                    timeout(time: 30, unit: 'MINUTES') {
                        input message: "Roll back the production UI from ${shown} to ${env.TARGET_COMMIT.take(7)} (delivery build #${env.TARGET_BUILD_CLEAN}, ${env.TARGET_DIGEST})?",
                              ok: 'Roll back'
                    }
                }
            }
        }

        // Only one job at a time may change production. The lock is taken after the approval so that
        // a waiting rollback never blocks a release.
        stage('Execute rollback') {
            agent { label 'docker' }
            options {
                lock('shelter-production')
            }
            steps {
                // The agent workspace is fresh after the approval wait (the release records need the repository).
                checkout scm
                withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                    script {
                        def image = "${env.IMAGE_REPO}@${env.TARGET_DIGEST}"
                        def revision = null
                        try {
                            def deployId = render.deployImage(env.PROD_ID, image)
                            render.waitForDeploy(env.PROD_ID, deployId)

                            revision = render.fetchRevision(env.PROD_URL)
                            if (revision && revision != env.TARGET_COMMIT) {
                                error "The production UI reports revision ${revision}, expected ${env.TARGET_COMMIT}"
                            }
                            if (!revision) {
                                echo 'WARNING: the target version does not report a revision (it predates version.json). Only the smoke tests and the routing are verified.'
                            }
                            render.smokeUi(env.PROD_URL)

                            render.verifyServedBy(env.PROD_HOST)
                            if (revision) {
                                render.verifyThroughProxy(env.PROD_HOST, revision)
                            }
                            render.smokeUi(env.PROXY_URL)
                            echo "Production UI now runs ${revision ?: env.TARGET_COMMIT}"
                        } catch (e) {
                            echo "Verification after the rollback failed (${e.getMessage()})."
                            if (env.CURRENT_REVISION != 'unknown') {
                                def previousImage = render.imageForRevision(env.CURRENT_REVISION)
                                echo "Restoring ${previousImage}"
                                def deployId = render.deployImage(env.PROD_ID, previousImage)
                                render.waitForDeploy(env.PROD_ID, deployId)
                                render.verifyRevision(env.PROD_URL, env.CURRENT_REVISION)
                            } else {
                                echo 'WARNING: the version that was running before is unknown, so it was not restored.'
                            }
                            error "Rollback failed: ${e.getMessage()}"
                        }

                        // Reached only when the rollback succeeded (the catch block always ends with error)
                        render.recordRelease(env.TARGET_COMMIT, env.TARGET_DIGEST, 'rollback')
                    }
                }
            }
        }
    }
}