server {
    listen 8080;
    server_name _;

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;
    proxy_connect_timeout 10s;
    # A sleeping free instance needs ~2 minutes to wake up
    proxy_read_timeout 180s;

    # Render health check target, independent of the upstream state
    location = /proxy-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # API traffic
    location ^~ /api/ {
        proxy_pass https://${API_UPSTREAM};
        proxy_set_header Host ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header X-Served-By ${API_UPSTREAM} always;
    }

    # Everything else (the single-page application)
    location / {
        proxy_pass https://${UI_UPSTREAM};
        proxy_set_header Host ${UI_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header X-Served-By ${UI_UPSTREAM} always;
    }
}