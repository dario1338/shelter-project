def render

// Continuous delivery of the UI: staging, approval, production.
// The UI is a static site without state, so production is a single service (no blue/green pair):
// Render starts the new instance and routes traffic to it only after its health check passes,
// and a failed release is undone by deploying the previous image again.
pipeline {
    // No pipeline-wide agent: every part that does work allocates its own,
    // so the manual approval does not hold an executor while it waits.
    agent none

    parameters {
        string(name: 'GIT_COMMIT_FULL', defaultValue: '',
               description: 'Full commit hash (40 characters) of the UI image to deliver')
        string(name: 'IMAGE_DIGEST', defaultValue: '',
               description: 'Digest (sha256:...) of the image built by CI. Set by CI. If empty (manual run), the image is taken by tag, which is weaker')
        booleanParam(name: 'TEST_ROLLBACK', defaultValue: false,
               description: 'TEST ONLY: fail the verification right after the production deploy, to demonstrate the automatic rollback')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        // The builds are the release history (each keeps its release record), so keep many of them.
        buildDiscarder(logRotator(numToKeepStr: '100', artifactNumToKeepStr: '100'))
        // A failed release restores what ran before; the record of the last successful build tells which digest that was.
        // The rollback jobs read the records of this job.
        copyArtifactPermission('shelter-cd*,shelter-rollback*')
    }

    stages {
        stage('Staging') {
            agent { label 'docker' }
            stages {
                stage('Load helpers') {
                    steps {
                        checkout scm
                        script {
                            render = load 'jenkins/render.groovy'
                            render.init()
                            render.useComponent('ui')
                        }
                    }
                }

                stage('Validate parameters') {
                    steps {
                        script {
                            def commit = params.GIT_COMMIT_FULL.trim()
                            if (!(commit ==~ /^[0-9a-f]{40}$/)) {
                                error "GIT_COMMIT_FULL must be a full 40-character hash, got: '${commit}'"
                            }
                            env.COMMIT_FULL = commit
                            // The digest identifies the exact content CI built and scanned; a tag can be
                            // moved to other content. Deliver by digest whenever CI provides one.
                            def digest = params.IMAGE_DIGEST.trim()
                            if (digest) {
                                if (!(digest ==~ /^sha256:[0-9a-f]{64}$/)) {
                                    error "IMAGE_DIGEST must look like sha256:<64 hex characters>, got: '${digest}'"
                                }
                                env.IMAGE_URL = "${env.IMAGE_REPO}@${digest}"
                            } else {
                                echo 'WARNING: IMAGE_DIGEST is empty (manual run). Delivering by tag, which is weaker than by digest.'
                                env.IMAGE_URL = "${env.IMAGE_REPO}:${commit.take(7)}"
                            }
                            env.RELEASE_DIGEST = digest
                            // The build list then shows which version each build delivers (rollbacks pick a build from it)
                            currentBuild.displayName = "#${env.BUILD_NUMBER} ${commit.take(7)}"
                            echo "Delivering image ${env.IMAGE_URL}"
                        }
                    }
                }

                stage('Staging: deploy') {
                    steps {
                        withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                            script {
                                def deployId = render.deployImage(env.STAGING_ID, env.IMAGE_URL)
                                render.waitForDeploy(env.STAGING_ID, deployId)
                            }
                        }
                    }
                }

                stage('Staging: verify revision') {
                    steps {
                        script {
                            render.verifyRevision(env.STAGING_URL, env.COMMIT_FULL)
                        }
                    }
                }

                // Staging has no proxy in front of it, so this checks that the image itself serves
                // the app. The connection to the API is verified in production, through the proxy.
                stage('Staging: smoke tests') {
                    steps {
                        script {
                            render.smokeUi(env.STAGING_URL)
                        }
                    }
                }
            }
        }

        // No agent here on purpose: waiting for a human must not occupy an executor.
        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Release ${env.IMAGE_URL} to production?", ok: 'Release'
                }
            }
        }

        // Only one job at a time may change production (API release, UI release or rollback).
        // The lock is taken after the approval so that a waiting release never blocks a rollback.
        stage('Production release') {
            agent { label 'docker' }
            options {
                lock('shelter-production')
            }
            steps {
                // The agent workspace is fresh after the approval wait (the release records need the repository).
                checkout scm
                withCredentials([string(credentialsId: 'render-api-key', variable: 'RENDER_KEY')]) {
                    script {
                        // What production looks like before this release, to be able to restore it.
                        // The revision is '' when the running image predates version.json.
                        def previousUpstream = render.proxyEnvVar(env.UPSTREAM_KEY)
                        def previousRevision = render.fetchRevision(env.PROD_URL)
                        echo "The proxy serves the UI from ${previousUpstream}; the production UI service reports revision '${previousRevision ?: 'unknown'}'"

                        try {
                            def deployId = render.deployImage(env.PROD_ID, env.IMAGE_URL)
                            render.waitForDeploy(env.PROD_ID, deployId)
                            render.verifyRevision(env.PROD_URL, env.COMMIT_FULL)
                            render.smokeUi(env.PROD_URL)

                            // The first UI release also points the proxy to the UI service.
                            if (previousUpstream != env.PROD_HOST) {
                                echo "Pointing ${env.UPSTREAM_KEY} of the proxy to ${env.PROD_HOST}"
                                render.setUpstream(env.PROD_HOST)
                            }
                            render.verifyThroughProxy(env.PROD_HOST, env.COMMIT_FULL)
                            render.smokeUi(env.PROXY_URL)

                            if (params.TEST_ROLLBACK) {
                                error 'TEST_ROLLBACK is set: simulated failure after the production deploy'
                            }
                        } catch (e) {
                            echo "Verification failed (${e.getMessage()}). Restoring the previous state."
                            if (previousUpstream != env.PROD_HOST && render.proxyEnvVar(env.UPSTREAM_KEY) != previousUpstream) {
                                render.setUpstream(previousUpstream)
                            }
                            if (previousRevision) {
                                def previousImage = render.imageForRevision(previousRevision)
                                def deployId = render.deployImage(env.PROD_ID, previousImage)
                                render.waitForDeploy(env.PROD_ID, deployId)
                                render.verifyRevision(env.PROD_URL, previousRevision)
                                echo "Production UI restored to ${previousImage}"
                            } else {
                                echo 'WARNING: the previous UI version is unknown (it predates version.json), so the image was not restored.'
                            }
                            error "Release failed and was rolled back: ${e.getMessage()}"
                        }

                        // Reached only when the release succeeded (the catch block always ends with error)
                        render.recordRelease(env.COMMIT_FULL, env.RELEASE_DIGEST)
                    }
                }
            }
        }
    }
}