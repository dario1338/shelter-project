# Copy to .env (not committed). None of these values is a secret; the database password is
# a file, see README.md. The defaults are the production values, so on the server this file
# only needs SECRETS_DIR and SONARQUBE_BIND.

# Database user and name. The name must stay "sonarqube": the dump of the existing database
# was made from a database of that name.
#SONAR_DB_USER=sonarqube
#SONAR_DB_NAME=sonarqube

# Directory with the secret file (default ./secrets). On the server keep it outside the repository.
#SECRETS_DIR=/opt/shelter-jenkins/secrets

# SonarQube listens only on the machine itself; Caddy (jenkins/caddy) is the way in from outside.
# The default is 0.0.0.0, so this must be set on the server.
SONARQUBE_BIND=127.0.0.1

# Overrides for the laptop test (defaults are the production names):
#SONARQUBE_PORT=19000
#SONARQUBE_CONTAINER=sonarqube-test
#SONARQUBE_DB_CONTAINER=sonarqube-db-test
#SONARQUBE_DATA_VOLUME=sonarqube_test_data
#SONARQUBE_EXTENSIONS_VOLUME=sonarqube_test_extensions
#SONARQUBE_LOGS_VOLUME=sonarqube_test_logs
#SONARQUBE_DB_VOLUME=sonarqube_test_db
#CI_NETWORK=shelter-ci-test-network
