# Copy to .env (not committed) and fill in. None of these values is a secret;
# the secrets are files, see README.md.

# Local Jenkins administrator (the user id, not the password)
JENKINS_ADMIN_ID=
# Public URL of Jenkins, with a trailing slash. Production: the HTTPS address that Caddy serves
# (jenkins/caddy). Test: http://localhost:18080/
SHELTER_JENKINS_URL=https://shelter-jenkins.duckdns.org/
# Jenkins listens only on the machine itself; Caddy (jenkins/caddy) is the way in from outside.
JENKINS_BIND=127.0.0.1
GITHUB_USERNAME=dario1338
DOCKERHUB_USERNAME=

# Group id of the docker group on the host that runs the agent: getent group docker | cut -d: -f3
DOCKER_GID=
# Contents of the agent's public key file (one line, "ssh-ed25519 AAAA... comment")
JENKINS_AGENT_SSH_PUBKEY=

# Directory with the secret files (default ./secrets). On the server keep it outside the repository.
#SECRETS_DIR=/opt/shelter-jenkins/secrets

# Overrides for tests (defaults are the production names):
#JENKINS_PORT=18080
#JENKINS_CONTAINER=jenkins-test
#JENKINS_HOME_VOLUME=jenkins_home_test
#AGENT_HOME_VOLUME=jenkins-agent-test-home
#CI_NETWORK=shelter-ci-test-network
